# Copy to .env and fill in. Never commit .env.

# --- Language model (tool calling) ---------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Backup models, tried in order if the main one is overloaded, out of quota or retired
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# OPENAI_API_KEY=            # if LLM_PROVIDER=openai
# GROQ_API_KEY=              # if LLM_PROVIDER=groq

# --- MLflow --------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=breast-cancer-classification
MLFLOW_MODEL_NAME=breast-cancer-classifier

# --- Airflow 3 (docker-compose.yml uses AIRFLOW_PASSWORD as the admin password) -------
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
AIRFLOW_APPROVED_DAGS=training_pipeline

# --- Kubernetes ----------------------------------------------------------------------
K8S_CONTEXT=docker-desktop
K8S_NAMESPACE=mlops-demo
K8S_ALLOWED_NAMESPACES=mlops-demo

# --- Policies ------------------------------------------------------------------------
QUALITY_GATE_MIN_F1=0.90
RETRAIN_MAX_MODEL_AGE_DAYS=30

# --- Agent ---------------------------------------------------------------------------
AGENT_TOOL_TIMEOUT=30
AGENT_MAX_STEPS=25
